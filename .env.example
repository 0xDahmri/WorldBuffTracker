# Copy this file to .env and fill in your values

# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Channel(s) where the bot should post buff alerts.
# Use CHANNEL_IDS for multiple channels (comma-separated), or CHANNEL_ID for one.
# Additional channels can be added/removed at runtime with /channel add and /channel remove.
# Right-click a channel in Discord > Copy Channel ID (requires Developer Mode)
CHANNEL_IDS=123456789012345678,987654321098765432

# The exact realm name as it appears on whenbuff.com
REALM_NAME=Your Realm Name

# Base URL for buff icon images — use your GitHub raw content URL after pushing.
# Example: https://raw.githubusercontent.com/yourname/WorldBuffTracker/main
# Leave unset to disable icons.
ICON_BASE_URL=https://raw.githubusercontent.com/yourname/WorldBuffTracker/main

# How many minutes before a buff goes out to send an alert (default: 15)
ALERT_MINUTES=15

# How often to post a periodic summary, in minutes (default: 30)
SUMMARY_INTERVAL=30
